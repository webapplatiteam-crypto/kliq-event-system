{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/staff", "destination": "/staff/login.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/stage", "destination": "/stage/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    { "source": "/(.*)\\.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(app\\.js|app\\.css|config\\.js|admin/admin\\.js)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(assets|vendor)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
